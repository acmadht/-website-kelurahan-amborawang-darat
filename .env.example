# Firebase Web App, boleh terlihat di browser
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin, rahasia dan hanya dipasang di server/Vercel
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary, rahasia kecuali cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opsional. Nama folder utama aset di Cloudinary
CLOUDINARY_FOLDER=website-kelurahan

# Hanya dipakai saat menjalankan npm run bootstrap-admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=GantiDenganPasswordKuat123!
BOOTSTRAP_ADMIN_NAME=Admin Kelurahan

# Opsional. Cadangan jika akun lama belum memiliki custom claims.
# Pisahkan beberapa email dengan koma.
UPLOAD_ALLOWED_EMAILS=admin.kelurahan@gmail.com
